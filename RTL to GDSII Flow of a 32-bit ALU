6. Code explaination:

This is your ALU in Verilog the hardware we are designing.
module alu (
    input  [31:0] a,
    input  [31:0] b,
    input  [3:0]  op,
    output reg [31:0] y,
    output zero,
    output neg,
    output reg carry,
    output reg ovf
);

  always @(*) begin
    carry = 0;
    ovf   = 0;
    case (op)
      4'b0000: {carry, y} = a + b;   // ADD
      4'b0001: {carry, y} = a - b;   // SUB
      4'b0010: y = a & b;            // AND
      4'b0011: y = a | b;            // OR
      4'b0100: y = a ^ b;            // XOR
      4'b0101: y = a << b[4:0];      // SLL
      4'b0110: y = a >> b[4:0];      // SRL
      4'b0111: y = $signed(a) >>> b[4:0]; // SRA
      4'b1000: y = ($signed(a) < $signed(b)); // SLT
      default: y = 0;
    endcase
  end

  assign zero = (y == 0);
  assign neg  = y[31];

endmodule

Python Testbench (cocotb)
We wrote a Python testbench with cocotb, instead of pure Verilog.
import random
import cocotb
from cocotb.triggers import Timer
import ctypes

def s32(x):
    return ctypes.c_int32(x & 0xFFFFFFFF).value

@cocotb.test()
async def test_basic_ops(dut):
    """Basic ALU operation tests"""

    dut.a.value, dut.b.value, dut.op.value = 10, 5, 0
    await Timer(1, unit="ns")
    assert int(dut.y.value) == 15

    dut.a.value, dut.b.value, dut.op.value = 10, 5, 1
    await Timer(1, unit="ns")
    assert int(dut.y.value) == 5

    dut.a.value, dut.b.value, dut.op.value = 0xF0F0, 0x0FF0, 2
    await Timer(1, unit="ns")
    assert int(dut.y.value) == (0xF0F0 & 0x0FF0)

    dut.op.value = 3
    await Timer(1, unit="ns")
    assert int(dut.y.value) == (0xF0F0 | 0x0FF0)

    dut.op.value = 4
    await Timer(1, unit="ns")
    assert int(dut.y.value) == (0xF0F0 ^ 0x0FF0)

    dut.a.value, dut.b.value, dut.op.value = 1, 2, 5
    await Timer(1, unit="ns")
    assert int(dut.y.value) == 4

    dut.a.value, dut.b.value, dut.op.value = 0x10, 2, 6
    await Timer(1, unit="ns")
    assert int(dut.y.value) == 4

    dut.a.value, dut.b.value, dut.op.value = -16 & 0xFFFFFFFF, 2, 7
    await Timer(1, unit="ns")
    assert s32(int(dut.y.value)) == (-16 >> 2)

    dut.a.value, dut.b.value, dut.op.value = -5 & 0xFFFFFFFF, 3, 8
    await Timer(1, unit="ns")
    assert int(dut.y.value) == 1

@cocotb.test()
async def test_random_ops(dut):
    """Randomized ADD and SLT"""
    for _ in range(50):
        a = random.getrandbits(32)
        b = random.getrandbits(32)

        dut.a.value, dut.b.value, dut.op.value = a, b, 0
        await Timer(1, unit="ns")
        assert int(dut.y.value) == ((a + b) & 0xFFFFFFFF)

        dut.a.value, dut.b.value, dut.op.value = a, b, 8
        await Timer(1, unit="ns")
        expect = 1 if s32(a) < s32(b) else 0
        assert int(dut.y.value) == expect
Why:
	•	Python is more expressive than Verilog for testbenches.
	•	Randomized testing increases coverage.
	•	Easy integration with CI flows.

7. Makefile for cocotb + Verilator
TOPLEVEL_LANG = verilog
VERILOG_SOURCES = ../rtl/alu.v ../rtl/alu_tb_wrap.v
TOPLEVEL = alu_tb_wrap
MODULE = test_alu
SIM = verilator

EXTRA_ARGS += --trace --trace-structs

include $(shell cocotb-config --makefiles)/Makefile.sim

Why:
	•	Tells cocotb where RTL + testbench are.
	•	Enables waveform tracing.

8. Wrapper for Waveform Dump
`timescale 1ns/1ps
module alu_tb_wrap;

  reg  [31:0] a, b;
  reg  [3:0]  op;
  wire [31:0] y;
  wire zero, neg, carry, ovf;

  alu dut (.a(a), .b(b), .op(op), .y(y), .zero(zero), .neg(neg), .carry(carry), .ovf(ovf));

  initial begin
    $dumpfile("dump.vcd");
    $dumpvars(0, alu_tb_wrap);
  end

endmodule

Why: Cocotb doesn’t always start dumps automatically → wrapper guarantees waveform output.

