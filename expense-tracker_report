5. Code Explanation

Database Setup

DB_URL = "sqlite:///expenses.db"
engine = create_engine(DB_URL, future=True)

def init_db():
    with engine.begin() as conn:
        conn.execute(text("""
            CREATE TABLE IF NOT EXISTS expenses (
                id INTEGER PRIMARY KEY AUTOINCREMENT,
                date TEXT NOT NULL,
                category TEXT NOT NULL,
                description TEXT,
                amount REAL NOT NULL
            )
        """))

	•	We used SQLite with SQLAlchemy ORM.
	•	Table expenses stores all records.

⸻

Insert Expense

def insert_expense(exp_date, category, description, amount):
    with engine.begin() as conn:
        conn.execute(
            text("INSERT INTO expenses (date, category, description, amount) VALUES (:d, :c, :desc, :a)"),
            {"d": exp_date, "c": category, "desc": description, "a": amount}
        )

	•	Inserts new records from the UI into the database.

⸻

Fetch Data

def fetch_df():
    df = pd.read_sql("SELECT * FROM expenses ORDER BY date DESC, id DESC", engine)
    if not df.empty:
        df["date"] = pd.to_datetime(df["date"]).dt.date
    return df

	•	Retrieves all records and converts them into a Pandas DataFrame for analysis and display.

⸻

Delete / Clear Data

def delete_expense(exp_id):
    with engine.begin() as conn:
        conn.execute(text("DELETE FROM expenses WHERE id=:id"), {"id": exp_id})

def clear_all_expenses():
    with engine.begin() as conn:
        conn.execute(text("DELETE FROM expenses"))

	•	delete_expense removes a single row.
	•	clear_all_expenses removes all entries.

